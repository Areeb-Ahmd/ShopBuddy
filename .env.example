# Google Gemini API Key (for LLM and embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# DataStax AstraDB Configuration
ASTRA_DB_API_ENDPOINT=your_astra_db_api_endpoint_here
ASTRA_DB_APPLICATION_TOKEN=your_astra_db_application_token_here
ASTRA_DB_KEYSPACE=default_keyspace

# Deployment Environment (set to "gcp" on Cloud Run, omit or "local" for local dev)
DEPLOYMENT_ENV=local

# Server Configuration (Cloud Run sets this automatically)
PORT=8080
